# ---------------------------------------------------------------------------
# AI Creator Studio — configuration
#
#   cp .env.example .env.local
#
# You do NOT have to edit this file. Copied as-is it runs the whole app offline
# with placeholder assets. To generate for real, either add your keys on the
# Settings page in the app (recommended) or fill them in below.
# ---------------------------------------------------------------------------

# --- API keys ---------------------------------------------------------------
# Leave blank to use the in-app Settings page instead.
# Anthropic  -> https://console.anthropic.com/settings/keys
# KIE AI     -> https://kie.ai/api-key
# ElevenLabs -> https://elevenlabs.io/app/settings/api-keys  (voice; see below)
ANTHROPIC_API_KEY=
KIE_API_KEY=
ELEVENLABS_API_KEY=

# --- Provider wiring ---------------------------------------------------------
# `mock` runs offline with placeholder assets and costs nothing — the default so
# a fresh clone works immediately. Saving a key on the Settings page switches
# the matching stages to live automatically; you can also set them here.
#
#   images/lipsync: kie | mock
#   video:          kie | mock
#   voice:          elevenlabs | kie | mock
#   reasoning:      anthropic | mock
IMAGE_PROVIDER=mock
VIDEO_PROVIDER=mock
VOICE_PROVIDER=mock
LIPSYNC_PROVIDER=mock
LLM_PROVIDER=mock

# --- Models ------------------------------------------------------------------
# Change these to swap models without touching code. See docs/PROVIDERS.md.
# Sonnet is the default for cost; claude-opus-5 buys better storyboards and
# identity descriptions at a higher per-call price.
ANTHROPIC_MODEL=claude-sonnet-5

# Lip sync. Verify this id against your own KIE account — if it is wrong the
# render still completes, the clip just is not mouth-matched.
KIE_LIPSYNC_MODEL=volcengine/video-to-video-lip-sync
# `basic` adds scene detection + speaker id; `lite` is cheaper and does neither.
KIE_LIPSYNC_MODE=basic

# Seconds of tail added after the last spoken word when sizing a clip.
VIDEO_TAIL_PADDING_SECONDS=0.6

# Optional. ffmpeg lays a voice track over a clip when lip sync is unavailable.
# Found on PATH automatically; set this only to point at a specific binary.
# Nothing is installed — without ffmpeg, clip and voice stay separate files.
#FFMPEG_PATH=

# Every image the pipeline makes: creator portraits, identity sheets, scene
# keyframes and empty location plates. Passing reference images is what selects
# image-to-image, so one id covers both directions.
#
# Chosen over Seedream 5.0 Pro on a like-for-like test — identical compiled
# prompt, identical reference, one render each. Seedream produced the centred,
# glossy, posed-at-the-lens frame that reads as generated on sight. If you swap
# this for a model from another family, note that the adapter sends this one's
# schema (a `resolution` tier and `image_input`) and will need editing.
KIE_IMAGE_MODEL=nano-banana-pro

# Video. Takes the voice track as a reference and generates motion that is
# already speaking it, so no lip-sync pass is needed. Tops out at 720p, and the
# reference audio must be 2-15s.
KIE_VIDEO_MODEL_SPEECH=bytedance/seedance-2-fast

# --- Voice -------------------------------------------------------------------
# Voice runs DIRECTLY against ElevenLabs (VOICE_PROVIDER=elevenlabs), not through
# KIE. On a live account both KIE ElevenLabs models returned `500 internal error`
# for every request — including KIE's own documented example payload — while
# every other model on the same account worked. Direct is the working route.
#
# IMPORTANT: use a *premade* voice id. Voice Library entries fail with
# `402 Free users cannot use library voices via the API`, and only at render
# time. The creator form lists the ones your plan can actually use.
# v3 is markedly more natural than multilingual_v2 and understands inline
# delivery tags ([warmly], [excited]) which are interpreted, not read aloud.
# Its `stability` is three-valued: 0.0 Creative / 0.5 Natural / 1.0 Robust.
ELEVENLABS_MODEL=eleven_v3
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128

# Kept for the KIE route (VOICE_PROVIDER=kie). Left in place so the path is
# there if KIE fixes it; see docs/PROVIDERS.md for the three doc errors the
# adapter already corrects.
KIE_VOICE_MODEL_TTS=elevenlabs/text-to-speech-multilingual-v2

# --- Endpoints ---------------------------------------------------------------
KIE_BASE_URL=https://api.kie.ai
# File upload lives on a different host from the job API.
KIE_UPLOAD_BASE_URL=https://kieai.redpandaai.co

# --- Sharing -----------------------------------------------------------------
# Leave blank for local use. Set it to ANY password before exposing the app —
# over a tunnel or on a host — and every page will ask for it first. Without
# this, anyone with the URL can drive the app and spend your API credits.
SHARE_PASSWORD=

# --- Dev server access -------------------------------------------------------
# The dev server only trusts addresses it knows about at startup: localhost plus
# this machine's own IPs. Reach it on anything else and hot reload is refused,
# which leaves every page rendered but completely unclickable.
#
# `http://localhost:3000` on the machine running the server always works and
# needs nothing here. Set this only to add another address — a phone on the LAN
# after your IP changed, a tunnel hostname. Comma-separated, exact matches only:
# CIDR ranges and wildcards are NOT supported.
#EXTRA_DEV_ORIGINS=192.168.1.17,studio.local

# --- Runtime -----------------------------------------------------------------
# Where the SQLite DB, saved settings and downloaded assets live.
# On a hosted server, point this at a persistent volume (e.g. /data).
DATA_DIR=./data
JOB_POLL_INTERVAL_MS=4000
# 30 minutes. Has to clear the slowest provider on a bad day, not a typical one:
# a client deadline that fires first turns a retryable timeout into a dead job.
JOB_TIMEOUT_MS=1800000

# --- Stock photos for automatic location references (both optional, both free) -
#
# Every scene is conditioned on a real photograph of its location, found
# automatically from the storyboard. Without a key this uses Openverse, which
# needs no signup; adding either key below gets better pictures.
#
#   Unsplash: https://unsplash.com/developers  (free, instant)
#   Pexels:   https://www.pexels.com/api/       (free, instant)
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
